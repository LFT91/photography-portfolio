# Fatni Photography — copy to `.env.local`
# Create a free project at https://supabase.com → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: your login email (admin). Create this user in Supabase Auth.
ADMIN_EMAIL=

# Domain later: add in Vercel → Project → Settings → Domains
# e.g. fatni.photography or fatniphotography.com
# Then set this so Open Graph / Twitter cards use the custom domain:
# NEXT_PUBLIC_SITE_URL=https://fatni.photography
NEXT_PUBLIC_SITE_URL=

# Which public site this deployment serves (public.sites.id).
# Defaults to fatni-photography when unset — keeps existing Fatni production compatible.
# NEXT_PUBLIC_SITE_ID=fatni-photography
# NEXT_PUBLIC_SITE_ID=ayoub-el-fatni
NEXT_PUBLIC_SITE_ID=
