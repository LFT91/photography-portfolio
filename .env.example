# Fatni Photography — copy to `.env.local`
# Create a free project at https://supabase.com → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: your login email (admin). Create this user in Supabase Auth.
ADMIN_EMAIL=

# Domain later: add in Vercel → Project → Settings → Domains
# e.g. fatni.photography or fatniphotography.com
