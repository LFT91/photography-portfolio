# Which public site this deployment serves.
# fatni-photography (default) or ayoub-el-fatni
NEXT_PUBLIC_SITE_ID=fatni-photography

# Canonical public origin for sitemap, robots, Open Graph, and canonical URLs.
# Fatni production: https://www.fatniphotography.com
# Ayoub production: https://ayoub-el-fatni.vercel.app
NEXT_PUBLIC_SITE_URL=

# Directory of camera originals (contains after-dark/, nature/, …).
# Required for `npm run images`. Not used at runtime.
# MASTERS_DIR=/path/to/fatni-photography-masters/images
