# Fatni Photography — copy to `.env.local`

# Which public site this deployment serves.
# Defaults to fatni-photography when unset.
# NEXT_PUBLIC_SITE_ID=fatni-photography
# NEXT_PUBLIC_SITE_ID=ayoub-el-fatni
NEXT_PUBLIC_SITE_ID=

# Canonical Fatni origin:
# NEXT_PUBLIC_SITE_URL=https://www.fatniphotography.com
NEXT_PUBLIC_SITE_URL=

# Local curator only: directory for ORIGINAL photograph files.
# Must exist. Add Photograph is disabled without it.
# Do not store masters in Git.
# MASTERS_DIR=/absolute/path/to/photo-masters
MASTERS_DIR=
